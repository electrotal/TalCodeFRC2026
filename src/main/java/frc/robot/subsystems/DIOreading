import edu.wpi.first.wpilibj.DigitalInput;
import edu.wpi.first.wpilibj.smartdashboard.SmartDashboard;
import edu.wpi.first.wpilibj2.command.SubsystemBase;

public class MySubsystem extends SubsystemBase {
    // הגדרת החיישן ליציאת DIO 3
    private final DigitalInput mySensor = new DigitalInput(6);

    @Override
    public void periodic() {
        // קריאת מצב החיישן ושליחתו ל-NetworkTables
        // מכיוון שזה חיבור דיגיטלי, הערך יהיה True או False
        SmartDashboard.putBoolean("Sensor DIO 3", mySensor.get());
    }
}

